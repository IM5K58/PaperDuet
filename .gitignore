# Dependencies and local toolchains
node_modules/
.venv/
.tools/

# Build output (regenerated by npm run build / build:sidecar / build:export)
dist/
build/
src-tauri/target/
src-tauri/resources/backend/
src-tauri/resources/backend-build/
src-tauri/gen/
backend/resources/export-template.html
*.tsbuildinfo

# Generated platform icons not used by the Windows build
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/*.icns
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png

# Python caches
__pycache__/
.pytest_cache/
*.pyc

# Tests, smoke installs, downloaded PDFs and logs
playwright-report/
test-results/
artifacts/
artifacts-*.log
*.log

# Sample paper (Rex-Omni, CC BY 4.0) is kept local only; the app, build and
# tests run without it.
fixtures/rex-omni.blocks.json
reference/

# Local app data (never commit a user's library)
*.sqlite3*

# Secrets: API keys, Tauri updater signing keys, code-signing certificates
.env*
*.key
*.key.pub
*.pem
*.pfx
*.p12

# Editors, OS and local agent settings
.claude/
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Documents
docs/*
!docs/licenses/