{
  "name": "paperduet",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "tsc -b && vite build && npm run build:export",
    "build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "build": "npm run build:sidecar && tauri build --bundles nsis",
    "test:e2e": "playwright test",
    "test:backend": ".venv\\Scripts\\python.exe -m pytest backend/tests -q",
    "tauri": "tauri",
    "build:export": "node scripts/build-export.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans-kr": "^5.2.0",
    "@fontsource/noto-serif-kr": "^5.2.0",
    "@fontsource/source-serif-4": "^5.2.0",
    "@tauri-apps/api": "2.12.0",
    "dompurify": "^3.2.7",
    "katex": "^0.18.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "2.12.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
